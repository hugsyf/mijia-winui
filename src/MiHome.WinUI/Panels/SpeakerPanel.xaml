<UserControl x:Class="MiHome.WinUI.Panels.SpeakerPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="using:MiHome.WinUI.Controls"
 HorizontalContentAlignment="Stretch">
 <UserControl.Resources>
  <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
   <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="0"/>
  </Style>
 </UserControl.Resources>
 <Border x:Name="PanelSurface" Style="{StaticResource DeviceSurfaceStyle}" Padding="16,12">
  <StackPanel Spacing="8">
   <Grid ColumnSpacing="8" MinHeight="32">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid VerticalAlignment="Center">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <controls:ProductIconView x:Name="SpeakerIcon" Width="28" Height="28" IconSize="24" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"/>
     <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
      <TextBlock x:Name="SpeakerName" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
      <ComboBox x:Uid="TraySpeakerPicker" x:Name="SpeakerPicker" DisplayMemberPath="Name" MinWidth="0" MinHeight="28"
       HorizontalAlignment="Stretch" Padding="6,2" SelectionChanged="OnSpeakerSelectionChanged" Visibility="Collapsed"/>
      <TextBlock x:Name="PlaybackState" Style="{ThemeResource CaptionTextBlockStyle}"
       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
    </Grid>
    <StackPanel x:Name="Transport" Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Visibility="Collapsed">
     <Button x:Uid="SpeakerPrevious" x:Name="Previous" Style="{StaticResource TransportButton}" Click="OnPrevious">
      <FontIcon Glyph="&#xE892;" FontSize="14"/>
     </Button>
     <Button x:Name="PlayPause" Style="{StaticResource TransportButton}" Click="OnPlayPause">
      <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="16"/>
     </Button>
     <Button x:Uid="SpeakerNext" x:Name="Next" Style="{StaticResource TransportButton}" Click="OnNext">
      <FontIcon Glyph="&#xE893;" FontSize="14"/>
     </Button>
    </StackPanel>
   </Grid>
   <Grid x:Name="VolumeRow" ColumnSpacing="4" Visibility="Collapsed">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="MuteButton" Style="{StaticResource TransportButton}" VerticalAlignment="Center" Click="OnMute">
     <FontIcon x:Name="MuteIcon" Glyph="&#xE767;" FontSize="16"/>
    </Button>
    <Slider x:Uid="SpeakerVolume" x:Name="Volume" Grid.Column="1" MinWidth="0" VerticalAlignment="Center" ValueChanged="OnVolumeChanged"/>
    <TextBlock x:Name="VolumeLabel" Grid.Column="2" MinWidth="30" TextAlignment="Right" VerticalAlignment="Center"
     Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <Button x:Uid="SpeakerTextButton" x:Name="TextButton" Grid.Column="3" Style="{StaticResource TransportButton}" VerticalAlignment="Center" Visibility="Collapsed">
     <FontIcon Glyph="&#xE8BD;" FontSize="16"/>
     <Button.Flyout>
      <Flyout x:Name="TextFlyout" Placement="Top" Opened="OnTextOpened">
       <StackPanel Width="216" Spacing="10">
        <SelectorBar x:Name="TextMode" SelectionChanged="OnTextModeChanged">
         <SelectorBarItem x:Uid="SpeakerDirective" x:Name="DirectiveMode"/>
         <SelectorBarItem x:Uid="SpeakerSpeak" x:Name="SpeakMode"/>
        </SelectorBar>
        <TextBox x:Uid="SpeakerTextInput" x:Name="TextInput" MaxLength="256" TextChanged="OnTextChanged"/>
        <Grid ColumnSpacing="8">
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <CheckBox x:Uid="SpeakerQuiet" x:Name="Quiet" MinWidth="0"/>
         <Button Grid.Column="1" x:Uid="SpeakerSend" x:Name="SendText" Style="{StaticResource AccentButtonStyle}" Click="OnSendText" IsEnabled="False">
          <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE724;" FontSize="14"/><TextBlock x:Uid="SpeakerSendLabel"/></StackPanel>
         </Button>
        </Grid>
       </StackPanel>
      </Flyout>
     </Button.Flyout>
    </Button>
   </Grid>
   <TextBlock x:Name="Feedback" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" MaxLines="2"
    TextTrimming="CharacterEllipsis" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
 </Border>
</UserControl>
