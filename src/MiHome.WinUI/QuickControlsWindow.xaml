<Window x:Class="MiHome.WinUI.QuickControlsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="using:MiHome.WinUI.Controls">
 <Grid x:Name="Surface" Padding="20">
  <Grid.Resources>
   <Storyboard x:Key="OpenMotion">
    <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16"/>
    <DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="Y" From="12" To="0" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
   </Storyboard>
   <Storyboard x:Key="CloseMotion">
    <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.10"/>
   </Storyboard>
  </Grid.Resources>
  <Grid x:Name="Body" RowSpacing="14" KeyDown="OnKeyDown">
   <Grid.RenderTransform><TranslateTransform x:Name="Motion"/></Grid.RenderTransform>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Uid="TrayTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
    <ComboBox x:Uid="TrayFamily" x:Name="Families" Grid.Column="1" MaxWidth="180" DisplayMemberPath="Name" SelectionChanged="OnFamilyChanged"/>
    <TextBlock x:Name="FamilyLabel" Grid.Column="1" MaxWidth="180" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   </Grid>
   <InfoBar x:Name="Feedback" Grid.Row="1" IsOpen="False" IsClosable="True" Severity="Informational"/>
   <Grid Grid.Row="2">
    <GridView x:Name="Devices" SelectionMode="None" Padding="0,0,8,0" HorizontalContentAlignment="Stretch"
     ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
     DragItemsCompleted="OnDragCompleted">
     <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" ItemWidth="104" ItemHeight="84"/></ItemsPanelTemplate></GridView.ItemsPanel>
     <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="CornerRadius" Value="8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/></Style></GridView.ItemContainerStyle>
     <GridView.ItemTemplate><DataTemplate><controls:QuickDeviceTile Loaded="OnTileLoaded"/></DataTemplate></GridView.ItemTemplate>
    </GridView>
    <StackPanel x:Name="Empty" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320">
     <FontIcon Glyph="&#xE80F;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <TextBlock x:Name="EmptyText" TextAlignment="Center" TextWrapping="Wrap"/>
     <Button x:Name="EmptyAction" Click="OnEmptyAction" HorizontalAlignment="Center"/>
    </StackPanel>
    <Grid x:Name="Details" Visibility="Collapsed" RowSpacing="12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <Button x:Uid="TrayBack" Click="OnBack" Padding="8" HorizontalAlignment="Left"><FontIcon Glyph="&#xE72B;" FontSize="16"/></Button>
     <TextBlock x:Name="DetailSummary" Grid.Row="1" TextWrapping="Wrap"/>
     <ScrollViewer Grid.Row="2" Padding="0,0,12,0" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <ContentControl x:Name="ExpandedHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"/>
     </ScrollViewer>
    </Grid>
   </Grid>
   <Grid Grid.Row="3" ColumnSpacing="8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ToggleButton x:Uid="TrayEdit" x:Name="Edit" Click="OnEdit" Width="36" Height="36" MinWidth="36" Padding="0"><FontIcon Glyph="&#xE70F;" FontSize="16"/></ToggleButton>
    <Button x:Uid="TrayChoose" x:Name="Choose" Grid.Column="1" Click="OnChoose" Width="36" Height="36" MinWidth="36" Padding="0" Visibility="Collapsed"><FontIcon Glyph="&#xE710;" FontSize="16"/></Button>
    <ProgressRing x:Name="Loading" Grid.Column="2" Width="20" Height="20" HorizontalAlignment="Center" IsActive="False"/>
    <Button x:Uid="TrayRefresh" x:Name="Refresh" Grid.Column="3" Click="OnRefresh" Width="36" Height="36" MinWidth="36" Padding="0"><FontIcon Glyph="&#xE72C;" FontSize="16"/></Button>
    <Button x:Uid="TrayOpenApp" Grid.Column="4" Click="OnOpenApp" Width="36" Height="36" MinWidth="36" Padding="0"><FontIcon Glyph="&#xE8A7;" FontSize="16"/></Button>
    <Button x:Uid="TraySettings" Grid.Column="5" Click="OnSettings" Width="36" Height="36" MinWidth="36" Padding="0"><FontIcon Glyph="&#xE713;" FontSize="16"/></Button>
   </Grid>
  </Grid>
 </Grid>
</Window>
