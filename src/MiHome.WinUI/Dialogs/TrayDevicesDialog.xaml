<ContentDialog x:Class="MiHome.WinUI.Dialogs.TrayDevicesDialog" x:Uid="TrayDevicesDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" DefaultButton="Primary" HorizontalContentAlignment="Stretch">
 <StackPanel Spacing="12">
  <TextBlock x:Name="Error" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
  <ListView x:Name="Choices" SelectionMode="Multiple" IsMultiSelectCheckBoxEnabled="True" MaxHeight="360" Padding="0,0,16,0">
   <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap" Padding="4,8"/></DataTemplate></ListView.ItemTemplate>
  </ListView>
 </StackPanel>
</ContentDialog>
