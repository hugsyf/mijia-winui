<UserControl x:Class="MiHome.WinUI.Controls.HomeOverviewView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" d:DesignWidth="1320" d:DesignHeight="900"
 xmlns:controls="using:MiHome.WinUI.Controls" MaxWidth="1320" HorizontalContentAlignment="Stretch">

 <StackPanel Spacing="22">
  <ItemsControl x:Name="AttentionItems"><ItemsControl.ItemTemplate><DataTemplate>
   <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Message="{Binding Message}" Margin="0,0,0,6">
    <InfoBar.ActionButton><HyperlinkButton x:Uid="Lb4b3c41d48a9"  Click="OnAttentionClick"/></InfoBar.ActionButton>
   </InfoBar>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <Grid x:Name="Columns" ColumnSpacing="22" RowSpacing="22" SizeChanged="OnColumnsSizeChanged">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="LeftColumn" Width="1.35*"/><ColumnDefinition x:Name="RightColumn"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Spacing="22">
    <StackPanel x:Name="EnvironmentSection" Spacing="12">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Uid="L287fbd284ad0"  FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="Updated" Grid.Column="1" FontSize="12" Style="{ThemeResource DeviceSecondaryTextStyle}" VerticalAlignment="Center"/>
     </Grid>
     <ItemsControl x:Name="EnvironmentItems">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:AdaptiveTilesPanel MinimumItemWidth="170" MaximumColumns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Button Style="{ThemeResource HomeCardButtonStyle}" MinHeight="160" Click="OnEnvironmentClick" ToolTipService.ToolTip="{Binding Hint}">
        <Button.ContextFlyout><MenuFlyout><MenuFlyoutItem x:Uid="L894512f05371"  Click="OnSourceClick"/></MenuFlyout></Button.ContextFlyout>
        <StackPanel>
         <TextBlock Text="{Binding Room}" FontWeight="SemiBold" Margin="0,0,0,22"/>
         <TextBlock x:Uid="L7cf16a8bc661"  Visibility="{Binding ChooseVisibility}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
         <StackPanel Visibility="{Binding ReadingVisibility}"><TextBlock FontSize="30" FontWeight="SemiBold"><Run Text="{Binding Temperature}"/><Run Text="{Binding Unit}" FontSize="13" FontWeight="Normal"/></TextBlock><TextBlock Text="{Binding Humidity}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,6,0,0"/></StackPanel>
        </StackPanel>
       </Button>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
    <StackPanel x:Name="SensorSection" Spacing="12">
     <TextBlock x:Uid="La4749c74bfa5"  FontSize="18" FontWeight="SemiBold"/>
     <ItemsControl x:Name="SensorItems">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:AdaptiveTilesPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Button Style="{ThemeResource HomeCardButtonStyle}" MinHeight="88" Click="OnSecurityClick" ToolTipService.ToolTip="{Binding Hint}">
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <controls:ProductIconView Tile="{Binding Tile}" IconSize="32"/>
         <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="2"/></StackPanel>
        </Grid>
       </Button>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
    <StackPanel Spacing="12">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Uid="L299477aec1b6"  FontSize="18" FontWeight="SemiBold"/><HyperlinkButton x:Uid="L6a2cfd62ea3d" Grid.Column="1"  Padding="0" MinHeight="24" Click="OnPinsClick"/></Grid>
     <Button x:Uid="L5cc12ef3c66e" x:Name="EmptyPins"  HorizontalAlignment="Left" Click="OnPinsClick"/>
     <controls:DeviceGridView x:Name="Favorites" IsItemClickEnabled="True" SelectionMode="None" Margin="-6" Padding="0" ItemClick="OnFavoriteClick" SizeChanged="OnFavoritesSizeChanged" Loaded="OnFavoritesLoaded" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <controls:DeviceGridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="260" ItemHeight="88"/></ItemsPanelTemplate></controls:DeviceGridView.ItemsPanel>
     </controls:DeviceGridView>
    </StackPanel>
   </StackPanel>
   <StackPanel x:Name="RightSections" Grid.Column="1" Spacing="22">
    <StackPanel x:Name="LightingSection" Spacing="12">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Uid="Lc03df689ff36"  FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <ToggleButton x:Name="AllLightingPower" Grid.Column="1" Width="36" Height="36" MinWidth="36" MinHeight="36" Padding="0" CornerRadius="18" Click="OnAllLightingClick"><FontIcon Glyph="&#xE7E8;" FontSize="16"/></ToggleButton>
     </Grid>
     <Border Style="{ThemeResource DeviceSurfaceStyle}" Padding="0">
      <ItemsControl x:Name="LightingItems"><ItemsControl.ItemTemplate><DataTemplate>
       <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="{Binding Separator}">
        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Button Style="{ThemeResource SubtleButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="14,10" MinHeight="56" CornerRadius="{Binding Corners}" Click="OnLightingClick">
          <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <controls:ProductIconView Tile="{Binding Icon}" IconSize="28"/>
           <TextBlock Grid.Column="1" Text="{Binding Room}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
           <TextBlock Grid.Column="2" Text="{Binding Summary}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
           <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontSize="12" Opacity="0.6"/>
          </Grid>
         </Button>
         <ToggleButton Grid.Column="1" IsChecked="{Binding Checked, Mode=OneWay}" Width="36" Height="36" MinWidth="36" MinHeight="36" Padding="0" CornerRadius="18" Margin="0,0,12,0" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding PowerHint}" AutomationProperties.Name="{Binding PowerHint}" Click="OnLightingPowerClick"><FontIcon Glyph="&#xE7E8;" FontSize="16"/></ToggleButton>
        </Grid>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </Border>
    </StackPanel>
    <StackPanel x:Name="NetworkSection" Spacing="12">
     <TextBlock x:Uid="Lf237e9f0ed9c"  FontSize="18" FontWeight="SemiBold"/>
     <ItemsControl x:Name="NetworkItems"><ItemsControl.ItemTemplate><DataTemplate>
      <Button Style="{ThemeResource HomeCardButtonStyle}" MinHeight="132" Margin="0,0,0,10" Click="OnDeviceClick" ToolTipService.ToolTip="{Binding Hint}">
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <controls:ProductIconView Tile="{Binding Tile}" IconSize="60"/>
        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Connected}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{Binding Speed}" FontSize="20" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
       </Grid>
      </Button>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
   </StackPanel>
  </Grid>
 </StackPanel>
</UserControl>
