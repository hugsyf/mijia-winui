<UserControl x:Class="MiHome.WinUI.Controls.QuickDeviceTile"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="using:MiHome.WinUI.Controls" HorizontalContentAlignment="Stretch">
 <Grid Height="76" RowSpacing="4">
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ToggleButton x:Name="MainButton" CornerRadius="4,0,0,4" BorderThickness="1,1,0,1" BackgroundSizing="OuterBorderEdge" Padding="0" MinWidth="0"
    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="OnMainClick">
    <controls:ProductIconView x:Name="DeviceIcon" IconSize="24"/>
   </ToggleButton>
   <ToggleButton x:Uid="TrayDetails" x:Name="DetailsButton" Grid.Column="1" Click="OnDetailsClick"
    MinWidth="0" Padding="0" CornerRadius="0,4,4,0" BackgroundSizing="OuterBorderEdge" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <FontIcon Glyph="&#xE76C;" FontSize="12"/>
   </ToggleButton>
  </Grid>
  <TextBlock x:Name="DeviceName" Grid.Row="1" Style="{ThemeResource CaptionTextBlockStyle}" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
 </Grid>
</UserControl>
