        <Border x:Name="DrawerScrim" Grid.ColumnSpan="2" Grid.RowSpan="4" Visibility="Collapsed" Background="#44000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Tapped="OnDrawerScrimTapped"/>
