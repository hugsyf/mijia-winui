           <StackPanel Spacing="4"><TextBlock x:Uid="L3a9cd34c20a5"  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="InformationRoom" TextWrapping="Wrap" /></StackPanel>
           <StackPanel Spacing="4"><TextBlock x:Uid="Lecf3d8d2b6d3"  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="InformationModel" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></StackPanel>
           <StackPanel Spacing="4"><TextBlock x:Uid="L1ada9e908652"  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Uid="L24cc93fcb952"  /></StackPanel>
          </StackPanel>
         </Expander>
        </StackPanel>

          </ScrollViewer>
         </Grid>
        </Border>
    </Grid>
   </Border>
  </NavigationView>
 </Grid>
</Window>
