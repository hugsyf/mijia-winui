          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition x:Name="DetailColumn" Width="*" /></Grid.ColumnDefinitions>
         <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><ContentControl x:Name="DetailIcon" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Border>
