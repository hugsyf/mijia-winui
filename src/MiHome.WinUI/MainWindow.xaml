           </Button>
           <Button x:Uid="L6063b139a260" x:Name="ExpandDetailButton"   Click="OnExpandDetail" Padding="8"><FontIcon Glyph="&#xE740;" FontSize="14"/></Button>
           <Button x:Uid="L9233a699b51f" x:Name="CloseDetailButton" Click="OnDetailBack" Padding="8"  ><FontIcon Glyph="&#xE711;" FontSize="14"/></Button>
