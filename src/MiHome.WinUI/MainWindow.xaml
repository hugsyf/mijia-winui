<Window x:Class="MiHome.WinUI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:cards="using:MiHome.WinUI.Controls" xmlns:pages="using:MiHome.WinUI.Pages" Title="米家 WinUI">
 <Grid x:Name="Root" KeyDown="OnShellKeyDown">
