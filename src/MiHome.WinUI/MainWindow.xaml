         <Expander x:Uid="L9689cbb99254" x:Name="CardAppearance"  Visibility="Collapsed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <StackPanel Spacing="12"><ComboBox x:Uid="Lae0c48d37834" x:Name="CardSizeChoice"  DisplayMemberPath="Label" SelectionChanged="OnCardSizeChanged" HorizontalAlignment="Left" MinWidth="180"/><ComboBox x:Uid="L5e7858b5ae96" x:Name="AppearanceChoice"  DisplayMemberPath="Label" SelectionChanged="OnCardAppearanceChanged" HorizontalAlignment="Left" MinWidth="180"/><TextBlock x:Uid="Lb791e8180dbd"  TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
         </Expander>
         <Expander x:Uid="La49bbb282af8" x:Name="DeviceInformation" Visibility="Collapsed"  IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
