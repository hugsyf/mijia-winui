<UserControl x:Class="MiHome.WinUI.Pages.AutomationPage" HorizontalContentAlignment="Stretch"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="using:MiHome.WinUI.Controls"
 xmlns:infra="using:MiHome.WinUI.Infrastructure"
 xmlns:pages="using:MiHome.WinUI.Pages">
 <UserControl.Resources>
  <Style x:Key="AutomationSurface" TargetType="Border" BasedOn="{StaticResource DeviceSurfaceStyle}">
   <Setter Property="Padding" Value="0"/>
  </Style>
  <Style x:Key="AutomationListItem" TargetType="ListViewItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Padding" Value="0"/>
   <Setter Property="MinHeight" Value="44"/>
  </Style>
  <Style x:Key="AutomationIconButton" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
   <Setter Property="Width" Value="32"/>
   <Setter Property="Height" Value="32"/>
   <Setter Property="MinWidth" Value="32"/>
   <Setter Property="Padding" Value="0"/>
  </Style>
 </UserControl.Resources>
 <Grid RowSpacing="12">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="960"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <SelectorBar x:Name="Tabs" SelectionChanged="OnTabChanged">
   <SelectorBarItem x:Uid="AutoScenesTab"/>
   <SelectorBarItem x:Uid="AutoRulesTab"/>
  </SelectorBar>
  <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True"/>

  <ScrollViewer x:Name="ListScroll" Grid.Row="2" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
   VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
   <Grid>
    <StackPanel x:Name="ScenesPane" Spacing="12">
     <StackPanel Orientation="Horizontal" Spacing="8">
      <ComboBox x:Uid="AutoHome" x:Name="SceneHome" DisplayMemberPath="Name" MinWidth="144" MaxWidth="260" SelectionChanged="OnSceneHomeChanged"/>
      <Button x:Uid="AutoRefresh" Click="OnRefreshScenes"><FontIcon Glyph="&#xE72C;" FontSize="16"/></Button>
      <ProgressRing x:Name="SceneLoading" Width="20" Height="20" IsActive="False"/>
     </StackPanel>
     <Border x:Name="SceneSurface" Style="{StaticResource AutomationSurface}" Visibility="Collapsed">
      <Grid>
       <TextBlock x:Uid="AutoNoScenes" x:Name="NoScenes" Margin="16,20" Visibility="Collapsed" Style="{ThemeResource DeviceSecondaryTextStyle}"/>
       <ListView x:Name="Scenes" IsItemClickEnabled="True" SelectionMode="None" ItemClick="OnRunScene"
        ItemContainerStyle="{StaticResource AutomationListItem}">
        <ListView.ItemTemplate>
         <DataTemplate x:DataType="infra:CloudScene">
          <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,10" MinHeight="52">
           <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE945;" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
            <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <FontIcon Grid.Column="2" Glyph="&#xE768;" FontSize="14" AutomationProperties.AccessibilityView="Raw"/>
           </Grid>
          </Border>
         </DataTemplate>
        </ListView.ItemTemplate>
       </ListView>
      </Grid>
     </Border>
    </StackPanel>

    <StackPanel x:Name="RulesPane" Spacing="12" Visibility="Collapsed">
     <controls:AdaptiveTilesPanel MinimumItemWidth="184" Spacing="8">
      <Button x:Name="NewRule" x:Uid="AutoNewRuleIcon" Click="OnNewRule" Style="{StaticResource AccentButtonStyle}">
       <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="16"/><TextBlock x:Uid="AutoNewRuleLabel"/></StackPanel>
      </Button>
      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
       <TextBlock x:Uid="AutoPauseLabel" VerticalAlignment="Center"/>
       <ToggleSwitch x:Uid="AutoPauseSwitch" x:Name="Pause" OnContent="" OffContent="" MinWidth="0" Toggled="OnPause"/>
      </StackPanel>
     </controls:AdaptiveTilesPanel>
     <InfoBar x:Name="TriggerIssue" IsOpen="False" IsClosable="False" Severity="Warning"/>
     <Border Style="{StaticResource AutomationSurface}">
      <Grid>
       <TextBlock x:Uid="AutoNoRules" x:Name="NoRules" Margin="16,20" Style="{ThemeResource DeviceSecondaryTextStyle}"/>
       <ListView x:Name="RuleList" IsItemClickEnabled="True" SelectionMode="None" ItemClick="OnEditRule"
        ItemContainerStyle="{StaticResource AutomationListItem}">
        <ListView.ItemTemplate>
         <DataTemplate x:DataType="pages:AutomationRuleRow">
          <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,10" MinHeight="56">
           <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE737;" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
            <StackPanel Grid.Column="1" Spacing="2">
             <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
             <TextBlock Text="{x:Bind Detail}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" AutomationProperties.AccessibilityView="Raw"/>
           </Grid>
          </Border>
         </DataTemplate>
        </ListView.ItemTemplate>
       </ListView>
      </Grid>
     </Border>
     <Expander x:Uid="AutoHistory" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0">
      <Grid>
       <TextBlock x:Uid="AutoHistoryEmpty" x:Name="HistoryEmpty" Margin="16,8,16,16" Style="{ThemeResource DeviceSecondaryTextStyle}"/>
       <ListView x:Name="History" SelectionMode="None" IsTabStop="False" ItemContainerStyle="{StaticResource AutomationListItem}">
        <ListView.ItemTemplate>
         <DataTemplate x:DataType="infra:AutomationRunEntry">
          <StackPanel Padding="16,8" Spacing="2">
           <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
           <TextBlock Text="{x:Bind Detail}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
          </StackPanel>
         </DataTemplate>
        </ListView.ItemTemplate>
       </ListView>
      </Grid>
     </Expander>
    </StackPanel>
   </Grid>
  </ScrollViewer>

  <Grid x:Name="Editor" Grid.Row="2" RowSpacing="12" Visibility="Collapsed">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid ColumnSpacing="10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Uid="AutoEditorBack" Click="OnCancelEdit" Style="{StaticResource AutomationIconButton}"><FontIcon Glyph="&#xE72B;" FontSize="16"/></Button>
    <TextBlock x:Name="EditorTitle" Grid.Column="1" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    <Button x:Uid="AutoDeleteIcon" x:Name="DeleteRule" Grid.Column="2" Click="OnDeleteRule" Style="{StaticResource AutomationIconButton}"><FontIcon Glyph="&#xE74D;" FontSize="16"/></Button>
   </Grid>
   <ScrollViewer x:Name="EditorScroll" Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
    VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
    <StackPanel Spacing="12">
     <Border Style="{StaticResource AutomationSurface}" Padding="16,14">
      <StackPanel Spacing="12">
       <controls:AdaptiveTilesPanel MinimumItemWidth="184" Spacing="12">
        <TextBox x:Uid="AutoName" x:Name="RuleName" MaxLength="80"/>
        <ComboBox x:Uid="AutoRuleHome" x:Name="RuleHome" DisplayMemberPath="Name" HorizontalAlignment="Stretch" SelectionChanged="OnRuleHomeChanged"/>
       </controls:AdaptiveTilesPanel>
       <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock x:Uid="AutoEnableLabel" VerticalAlignment="Center"/>
        <ToggleSwitch x:Uid="AutoEnableSwitch" x:Name="EnabledRule" OnContent="" OffContent="" MinWidth="0"/>
       </StackPanel>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource AutomationSurface}" Padding="16,14">
      <StackPanel Spacing="12">
       <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE945;" FontSize="16"/><TextBlock x:Uid="AutoWhen" Style="{ThemeResource BodyStrongTextBlockStyle}"/></StackPanel>
       <ComboBox x:Uid="AutoTrigger" x:Name="Trigger" DisplayMemberPath="Label" HorizontalAlignment="Left"
        MinWidth="220" MaxWidth="360" SelectionChanged="OnTriggerChanged"/>
       <Grid x:Name="ProgramRow" ColumnSpacing="8" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Button x:Uid="AutoBrowse" Click="OnPickProgram"/>
        <TextBlock x:Name="ProgramName" Grid.Column="1" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}"
         Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
       </Grid>
       <ComboBox x:Uid="AutoHotkey" x:Name="Hotkey" Visibility="Collapsed"/>
       <Grid x:Name="ThresholdRow" RowSpacing="4" MaxWidth="360" HorizontalAlignment="Left" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="ThresholdLabel"/>
        <TextBlock x:Name="ThresholdValue" Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Slider x:Name="Threshold" Grid.Row="1" Grid.ColumnSpan="2" MinWidth="220" Minimum="1" Maximum="240"
         StepFrequency="1" ValueChanged="OnThresholdChanged"/>
       </Grid>
       <StackPanel x:Name="ScheduleRow" Spacing="8" Visibility="Collapsed">
        <TimePicker x:Uid="AutoScheduleTime" x:Name="ScheduleTime" ClockIdentifier="24HourClock"/>
        <TextBlock x:Uid="AutoScheduleDays"/>
        <Grid x:Name="ScheduleDays" ColumnSpacing="4" HorizontalAlignment="Left">
         <Grid.ColumnDefinitions>
          <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
         </Grid.ColumnDefinitions>
         <ToggleButton x:Uid="AutoMonday" Grid.Column="0" MinWidth="36" Padding="5,5" Tag="1"/>
         <ToggleButton x:Uid="AutoTuesday" Grid.Column="1" MinWidth="36" Padding="5,5" Tag="2"/>
         <ToggleButton x:Uid="AutoWednesday" Grid.Column="2" MinWidth="36" Padding="5,5" Tag="3"/>
         <ToggleButton x:Uid="AutoThursday" Grid.Column="3" MinWidth="36" Padding="5,5" Tag="4"/>
         <ToggleButton x:Uid="AutoFriday" Grid.Column="4" MinWidth="36" Padding="5,5" Tag="5"/>
         <ToggleButton x:Uid="AutoSaturday" Grid.Column="5" MinWidth="36" Padding="5,5" Tag="6"/>
         <ToggleButton x:Uid="AutoSunday" Grid.Column="6" MinWidth="36" Padding="5,5" Tag="0"/>
        </Grid>
       </StackPanel>
       <ComboBox x:Uid="AutoUsbDevice" x:Name="UsbDevice" DisplayMemberPath="Label" MinWidth="220" MaxWidth="360"
        DropDownOpened="OnUsbChoicesOpened" Visibility="Collapsed"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource AutomationSurface}" Padding="16,14">
      <StackPanel Spacing="8">
       <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE71C;" FontSize="16"/><TextBlock x:Uid="AutoIf" Style="{ThemeResource BodyStrongTextBlockStyle}"/></StackPanel>
       <CheckBox x:Uid="AutoLimitTime" x:Name="LimitTime" Checked="OnTimeChanged" Unchecked="OnTimeChanged"/>
       <controls:AdaptiveTilesPanel x:Name="TimeRow" MinimumItemWidth="170" MaxWidth="420" HorizontalAlignment="Left" Spacing="12" Visibility="Collapsed">
        <TimePicker x:Uid="AutoFrom" x:Name="From" ClockIdentifier="24HourClock" HorizontalAlignment="Stretch"/>
        <TimePicker x:Uid="AutoUntil" x:Name="Until" ClockIdentifier="24HourClock" HorizontalAlignment="Stretch"/>
       </controls:AdaptiveTilesPanel>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource AutomationSurface}">
      <StackPanel>
       <Grid Padding="16,8,12,8" ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
         <FontIcon Glyph="&#xE9D9;" FontSize="16"/><TextBlock x:Uid="AutoThen" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
         <Button x:Uid="AutoMoveUp" x:Name="MoveUp" Click="OnMoveUp" IsEnabled="False" Style="{StaticResource AutomationIconButton}"><FontIcon Glyph="&#xE70E;" FontSize="14"/></Button>
         <Button x:Uid="AutoMoveDown" x:Name="MoveDown" Click="OnMoveDown" IsEnabled="False" Style="{StaticResource AutomationIconButton}"><FontIcon Glyph="&#xE70D;" FontSize="14"/></Button>
         <Button x:Uid="AutoRemoveStep" x:Name="RemoveStep" Click="OnRemoveStep" IsEnabled="False" Style="{StaticResource AutomationIconButton}"><FontIcon Glyph="&#xE74D;" FontSize="14"/></Button>
        </StackPanel>
       </Grid>
       <ListView x:Name="Steps" CanDragItems="True" CanReorderItems="True" AllowDrop="True"
        SelectionChanged="OnStepSelected" DragItemsCompleted="OnStepDragCompleted" ItemContainerStyle="{StaticResource AutomationListItem}">
        <ListView.ItemTemplate>
         <DataTemplate x:DataType="infra:AutomationStep">
          <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,8" MinHeight="44">
           <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE700;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw"/>
            <TextBlock Grid.Column="1" Text="{x:Bind Display}" TextWrapping="Wrap" VerticalAlignment="Center"/>
           </Grid>
          </Border>
         </DataTemplate>
        </ListView.ItemTemplate>
       </ListView>
       <Expander x:Uid="AutoAddStepHeader" x:Name="Composer" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="12">
         <ComboBox x:Uid="AutoStepType" x:Name="StepType" DisplayMemberPath="Label" MinWidth="160" SelectionChanged="OnStepTypeChanged"/>
         <StackPanel x:Name="WriteFields" Spacing="8">
          <controls:AdaptiveTilesPanel MinimumItemWidth="184" Spacing="12">
           <ComboBox x:Uid="AutoDevice" x:Name="Device" DisplayMemberPath="Label" HorizontalAlignment="Stretch" SelectionChanged="OnDeviceChanged"/>
           <ComboBox x:Uid="AutoProperty" x:Name="Property" DisplayMemberPath="Label" HorizontalAlignment="Stretch" SelectionChanged="OnPropertyChanged"/>
          </controls:AdaptiveTilesPanel>
          <ComboBox x:Uid="AutoValue" x:Name="ChoiceValue" DisplayMemberPath="Label" MinWidth="100" Visibility="Collapsed"/>
          <StackPanel x:Name="SliderHost" Spacing="4" MaxWidth="420" HorizontalAlignment="Stretch" Visibility="Collapsed">
           <TextBlock x:Name="SliderLabel" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
           <Slider x:Uid="AutoSliderValue" x:Name="SliderValue" SnapsTo="StepValues" ValueChanged="OnSliderChanged"/>
          </StackPanel>
          <NumberBox x:Uid="AutoNumber" x:Name="NumberValue" HorizontalAlignment="Left" MinWidth="140" SpinButtonPlacementMode="Inline" Visibility="Collapsed"/>
          <Button x:Uid="AutoColor" x:Name="ColorValue" Visibility="Collapsed">
           <Button.Flyout><Flyout><ColorPicker x:Name="Color" IsAlphaEnabled="False" IsHexInputVisible="True"/></Flyout></Button.Flyout>
          </Button>
         </StackPanel>
         <ComboBox x:Uid="AutoScene" x:Name="StepScene" DisplayMemberPath="Name" MinWidth="160" Visibility="Collapsed"/>
         <NumberBox x:Uid="AutoSeconds" x:Name="Seconds" Minimum="1" Maximum="300" Value="2" SpinButtonPlacementMode="Inline" HorizontalAlignment="Left" Visibility="Collapsed"/>
         <Button x:Uid="AutoAddStep" Click="OnAddStep"/>
        </StackPanel>
       </Expander>
      </StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>
   <Border Grid.Row="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
     <Button x:Uid="AutoCancelEdit" Click="OnCancelEdit"/>
     <Button x:Uid="AutoPreview" Click="OnPreview"/>
     <Button x:Uid="AutoSave" Click="OnSave" Style="{StaticResource AccentButtonStyle}"/>
    </StackPanel>
   </Border>
  </Grid>
 </Grid>
</UserControl>
