<UserControl x:Class="MiHome.WinUI.Pages.AdaptersPage" HorizontalContentAlignment="Stretch"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="using:MiHome.WinUI.Controls">
 <UserControl.Resources>
  <DataTemplate x:Key="PackageHeader">
   <Grid ColumnSpacing="12" MinHeight="48">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <Border Width="40" Height="40" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
     <controls:ProductIconView Tile="{Binding Icon}" IconSize="32"/>
    </Border>
    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
     <TextBlock Text="{Binding Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
     <TextBlock Text="{Binding Models}" Style="{ThemeResource DeviceSecondaryTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
    <TextBlock Grid.Column="2" Text="{Binding Version}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="3" Text="{Binding State}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
    <ToggleSwitch Grid.Column="4" IsOn="{Binding Enabled, Mode=OneWay}" OnContent="" OffContent="" MinWidth="0" Width="44"
     Visibility="{Binding CommandsVisibility}" AutomationProperties.Name="{Binding EnableLabel}" VerticalAlignment="Center" Toggled="OnEnabled"/>
   </Grid>
  </DataTemplate>
 </UserControl.Resources>

 <StackPanel Spacing="12">
  <TextBlock x:Uid="Lcfaf41f48a9f" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,0,0,4"/>
  <CommandBar x:Name="CatalogToolbar" Background="Transparent" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True"
   HorizontalContentAlignment="Left">
   <CommandBar.Content>
    <SelectorBar x:Name="Filter" VerticalAlignment="Center">
     <SelectorBarItem x:Uid="Lff36b7ec5283"/><SelectorBarItem x:Uid="L3407c48b4e34"/><SelectorBarItem x:Uid="Lbba2f6052eb4"/>
    </SelectorBar>
   </CommandBar.Content>
   <AppBarButton x:Uid="L4d7208c641a0" DynamicOverflowOrder="1">
    <AppBarButton.Icon><FontIcon Glyph="&#xE8CB;"/></AppBarButton.Icon>
    <AppBarButton.Flyout><MenuFlyout>
     <RadioMenuFlyoutItem x:Uid="L0dbbeb3e49bf" Tag="name" GroupName="AdapterSort" IsChecked="True" Click="OnSort"/>
     <RadioMenuFlyoutItem x:Uid="Lecf3d8d2b6d3" Tag="model" GroupName="AdapterSort" Click="OnSort"/>
     <RadioMenuFlyoutItem x:Uid="L2036b2d6aa8c" Tag="state" GroupName="AdapterSort" Click="OnSort"/>
     <MenuFlyoutSeparator/>
     <ToggleMenuFlyoutItem x:Uid="Lbd11994f7a0c" x:Name="Descending" Click="OnSort"/>
    </MenuFlyout></AppBarButton.Flyout>
   </AppBarButton>
   <AppBarToggleButton x:Uid="Le0bb11678145" x:Name="Select" Icon="SelectAll" DynamicOverflowOrder="2"/>
   <AppBarButton x:Uid="Lbb94250a82d2" x:Name="Refresh" Icon="Refresh" LabelPosition="Collapsed" DynamicOverflowOrder="3"/>
   <AppBarButton x:Uid="L7cdf6d5972fe" x:Name="Import" Icon="Add" DynamicOverflowOrder="4" CornerRadius="4"
    Background="{ThemeResource AccentFillColorDefaultBrush}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
   <CommandBar.SecondaryCommands>
    <AppBarButton x:Uid="Lcf825f2b7ef1" Icon="Upload">
     <AppBarButton.Flyout><MenuFlyout>
      <MenuFlyoutItem x:Uid="AdapterExportAll" Tag="all" Click="OnExportScope"/>
      <MenuFlyoutItem x:Uid="AdapterExportUnadapted" Tag="unadapted" Click="OnExportScope"/>
     </MenuFlyout></AppBarButton.Flyout>
    </AppBarButton>
    <AppBarButton x:Uid="L739274d277f5" x:Name="Guide" Icon="Help"/>
   </CommandBar.SecondaryCommands>
  </CommandBar>

  <Border x:Name="SelectionBar" Style="{ThemeResource DeviceSurfaceStyle}" Padding="12,6" Visibility="Collapsed">
   <controls:AdaptiveTilesPanel MinimumItemWidth="260" Spacing="8">
    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
     <CheckBox x:Uid="AdapterSelectAll" x:Name="SelectAll" IsThreeState="True" MinWidth="0"/>
     <TextBlock x:Name="Count" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
     <TextBlock x:Uid="L02c76a0c30d7" VerticalAlignment="Center"/>
     <ToggleSwitch x:Uid="Lccaa357c28cb" x:Name="SelectionEnabled" OnContent="" OffContent="" MinWidth="0"/>
     <Button x:Uid="La11d3df705a0" x:Name="RemoveSelected" Style="{ThemeResource SubtleButtonStyle}" Width="32" Height="32" Padding="0">
      <FontIcon Glyph="&#xE74D;" FontSize="16"/>
     </Button>
     <Button x:Uid="L5afd6169a769" Click="OnDone"/>
    </StackPanel>
   </controls:AdaptiveTilesPanel>
  </Border>
  <InfoBar x:Name="Result" IsOpen="False" IsClosable="True"/>
  <TextBlock x:Name="Empty" Style="{ThemeResource DeviceSecondaryTextStyle}" Margin="0,8,0,0" Visibility="Collapsed"/>
  <ListView x:Uid="Ld57055da8c9a" x:Name="Packages" SelectionMode="None" HorizontalContentAlignment="Stretch"
   ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollMode="Disabled">
   <ListView.ItemContainerStyle>
    <Style TargetType="ListViewItem">
     <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
     <Setter Property="Padding" Value="0"/>
     <Setter Property="MinHeight" Value="0"/>
     <Setter Property="Margin" Value="0,0,0,4"/>
     <Setter Property="CornerRadius" Value="6"/>
    </Style>
   </ListView.ItemContainerStyle>
   <ListView.ItemTemplate>
    <DataTemplate>
     <Grid>
      <Border Visibility="{Binding SelectionVisibility}" Style="{ThemeResource DeviceSurfaceStyle}" Padding="12,8" CornerRadius="6">
       <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}" Content="{Binding}" ContentTemplate="{StaticResource PackageHeader}"
        Padding="12,0,0,0" MinWidth="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Center" AutomationProperties.Name="{Binding Name}" Click="OnPackageSelection"/>
      </Border>
      <Expander Visibility="{Binding CommandsVisibility}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Expanding="OnDetailsExpanding">
       <Expander.Header>
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PackageHeader}" HorizontalContentAlignment="Stretch"/>
       </Expander.Header>
       <StackPanel Spacing="12">
        <Grid ColumnSpacing="16">
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel Spacing="4"><TextBlock x:Uid="Lc94598f64e45" Style="{ThemeResource DeviceSecondaryTextStyle}"/><TextBlock Text="{Binding SdkVersion}"/></StackPanel>
         <StackPanel Grid.Column="1" Spacing="4"><TextBlock x:Uid="Leca2f72e3bc0" Style="{ThemeResource DeviceSecondaryTextStyle}"/><TextBlock Text="{Binding Version}"/></StackPanel>
         <StackPanel Grid.Column="2" Spacing="4"><TextBlock x:Uid="Lcaaf0164d246" Style="{ThemeResource DeviceSecondaryTextStyle}"/><TextBlock Text="{Binding Author}" TextWrapping="Wrap"/></StackPanel>
        </Grid>
        <ContentControl HorizontalContentAlignment="Stretch"/>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
         <Button x:Uid="L274c95fa3930" Style="{ThemeResource SubtleButtonStyle}" Visibility="{Binding RollbackVisibility}" Click="OnRollback">
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72B;" FontSize="16"/><TextBlock x:Uid="L618873d4672e"/></StackPanel>
         </Button>
         <Button x:Uid="L47c7d259714d" Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.Name="{Binding RemoveLabel}" Click="OnRemove">
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74D;" FontSize="16"/><TextBlock x:Uid="L036ead5b89bf"/></StackPanel>
         </Button>
        </StackPanel>
       </StackPanel>
      </Expander>
     </Grid>
    </DataTemplate>
   </ListView.ItemTemplate>
  </ListView>
 </StackPanel>
</UserControl>
